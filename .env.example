# Default runs without an external model.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# Generate a long random value for production.
TENDER_SESSION_SECRET=
TENDER_DEMO_MODE=1
TENDER_ALLOW_HEADER_IDENTITY=0

# Optional workflow runtime switch. Keep disabled unless explicitly configured.
TENDER_AGENT_RUNTIME=legacy
TENDER_WORKFORCE_ENABLED=0
ENABLE_TENDER_WORKFORCE=0
